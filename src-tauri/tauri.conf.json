{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ATXXII Ban Picker & Match Timer",
  "version": "1.0.0",
  "identifier": "com.eve.atxxii.timer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ATXXII Ban Picker & Match Timer",
        "width": 940,
        "height": 680,
        "minWidth": 440,
        "minHeight": 240,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "alwaysOnTop": false,
        "decorations": false,
        "shadow": true,
        "theme": "Dark"
      },
      {
        "label": "timer-popout",
        "title": "ATXXII Match Timer",
        "width": 260,
        "height": 115,
        "minWidth": 200,
        "minHeight": 85,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["at22"]
      }
    }
  }
}
